# Copy to .env and adjust. All values have sensible local-dev defaults.

# Database. Default is local SQLite (zero setup).
DATABASE_URL=sqlite+aiosqlite:///./conditia.db
#
# --- Supabase / Postgres ---
# Paste the connection string from Supabase > Connect. The app auto-rewrites it
# to the asyncpg driver and enables TLS for *.supabase.co / *.supabase.com, so
# any of these formats work:
#   Session pooler (IPv4, recommended): host ...pooler.supabase.com, port 5432
#   DATABASE_URL=postgresql://postgres.<ref>:<PW>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   Direct (IPv6 only): postgresql://postgres:<PW>@db.<ref>.supabase.co:5432/postgres
#   Transaction pooler (port 6543): append ?prepared_statement_cache_size=0
# Percent-encode special chars in the password (e.g. '@' -> %40).
# Run migrations against it with:  alembic upgrade head
#
# TLS (required for production): download the CA from Supabase Dashboard →
# Database → SSL Configuration, save to backend/certs/supabase-ca.crt, then:
# DATABASE_SSL_CA=./certs/supabase-ca.crt
# See backend/certs/README.md. Without this, traffic is encrypted but the server
# identity is not verified (MITM risk).

# Where uploaded media is written in local-dev storage mode. Leave unset to use
# the portable backend/storage default from backend/paths.py.
# STORAGE_DIR=/absolute/path/to/private/storage
STORAGE_BACKEND=local

# Comma-separated allowed CORS origins (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed demo fleet data on startup if the DB is empty (off by default).
SEED_ON_STARTUP=false

# Security posture. Production refuses to start with authentication disabled.
#   disabled — local only, no sign-in
#   jwt      — per-user sessions (Supabase or mint_dev_token.py locally)
#   api_key  — single shared key for scripts/integrations only
ENVIRONMENT=development
AUTH_MODE=disabled
# JWT_SECRET=replace-with-at-least-32-random-characters
# JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
# API_KEY=replace-with-at-least-32-random-characters
# API_FLEET_ID=00000000-0000-0000-0000-000000000000
DOCS_ENABLED=true

# Upload quotas (bytes per file; files per multipart request).
MAX_UPLOAD_BYTES=26214400
MAX_FILES_PER_UPLOAD=6
MAX_REQUEST_BYTES=158334976
MAX_IMAGE_PIXELS=50000000
MAX_MEDIA_PER_INSPECTION=30
MAX_FRAMES_PER_VIDEO=60

# Rate limiting (required in production). 0 disables locally.
RATE_LIMIT_PER_MINUTE=0
RATE_LIMIT_MAX_KEYS=10000
MEDIA_TOKEN_TTL_SECONDS=300

# Postgres TLS: pin the Supabase CA (see backend/certs/README.md).
# DATABASE_SSL_CA=./certs/supabase-ca.crt
# DATABASE_SSL_INSECURE=true

# --- Optional ---
# SUPABASE_URL=
# SUPABASE_KEY=
# SUPABASE_STORAGE_BUCKET=inspection-media
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
