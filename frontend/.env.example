# Copy to .env.local for local overrides (not committed).

# Optional: override API base (default uses Vite /api proxy in dev).
# VITE_API_URL=/api

# Supabase Auth — required for production sign-in (Dashboard → Project Settings → API).
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon public key>

# When unset, the sign-in screen falls back to pasted dev JWT tokens (AUTH_MODE=jwt).
