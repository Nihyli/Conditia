# Copy to .env and adjust. All values have sensible local-dev defaults.

# Database. Default is local SQLite (zero setup).
DATABASE_URL=sqlite+aiosqlite:///./conditia.db
#
# --- Supabase / Postgres ---
# Paste the connection string from Supabase > Project Settings > Database.
# Any of these formats work (the app auto-rewrites them to the asyncpg driver
# and enables TLS for *.supabase.co / *.supabase.com hosts):
#
#   Direct (IPv6, port 5432):
#   DATABASE_URL=postgresql://postgres:<PW>@db.<ref>.supabase.co:5432/postgres
#
#   Session pooler (IPv4-friendly, port 5432 — recommended for dev):
#   DATABASE_URL=postgresql://postgres.<ref>:<PW>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
#   Transaction pooler (port 6543 — also append the cache flag):
#   DATABASE_URL=postgresql://postgres.<ref>:<PW>@aws-0-<region>.pooler.supabase.com:6543/postgres?prepared_statement_cache_size=0
#
# The app creates all tables automatically on startup (SQLAlchemy create_all),
# so running db/schema.sql by hand is optional.

# Where uploaded media is written in local-dev storage mode.
# Absolute path by default — see backend/paths.py
STORAGE_DIR=C:/Users/yhail/Projects/conditia/backend/storage

# Comma-separated allowed CORS origins (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed demo fleet data on startup if the DB is empty (off by default).
SEED_ON_STARTUP=false

# Enable POST /admin/seed and /admin/unseed from the dashboard (disable in production).
ADMIN_ENABLED=true

# Auth — local JWT by default. For Supabase Auth, set SUPABASE_URL + SUPABASE_JWT_SECRET.
AUTH_ENABLED=true
JWT_SECRET=change-me-in-production-use-openssl-rand

# auto | local | supabase — use "local" for demo accounts during development
AUTH_PROVIDER=auto

# --- Supabase Auth (production) ---
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-settings

# --- Optional ---
# SUPABASE_URL=
# SUPABASE_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
